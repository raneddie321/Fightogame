# FIGHTO humanoid animation clips (custom text format, loaded by src/game/character.cpp)
#
#   clip <name> <length-seconds> [loop] [hit <start> <end>]
#   key <time> [root x y z] <bone> <pitch> <yaw> <roll> ...
#
# Bones: pelvis spine chest neck head  lua lfa lh  rua rfa rh  lth lsh lft  rth rsh rft
# Angles in degrees. Character faces +Z, left side is +X.
#   thigh pitch < 0 : leg forward      shin pitch > 0 : knee bend
#   upper arm pitch < 0 : arm forward / up     forearm pitch < 0 : elbow bend
#   left arm roll > 0 / right arm roll < 0 : arm raised sideways
#   spine/chest pitch > 0 : lean forward      yaw > 0 : turn to the left
# Bones not listed in a key stay at the rest pose.

clip idle 3.2 loop
key 0.0 spine 1 0 0 | chest 0 0 0 | head 2 0 0 | lua 2 0 5 | rua 2 0 -5 | lfa -10 0 0 | rfa -10 0 0
key 1.6 root 0 0.005 0 spine 2 0 0 | chest 2 0 0 | head 1 4 0 | lua 1 0 6 | rua 1 0 -6 | lfa -12 0 0 | rfa -12 0 0
key 3.2 spine 1 0 0 | chest 0 0 0 | head 2 0 0 | lua 2 0 5 | rua 2 0 -5 | lfa -10 0 0 | rfa -10 0 0

